# URL of the Nublue API (no trailing slash). Development default: http://localhost:4000.
# Production builds require it; on GitHub Pages it comes from the repository variable VITE_API_URL.
VITE_API_URL=http://localhost:4000

# Base path of the site. GitHub Pages project sites use /<repo>/ (set by the deploy workflow).
# VITE_BASE_PATH=/
