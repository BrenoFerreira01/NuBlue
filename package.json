{
  "name": "nublue",
  "version": "0.3.0",
  "private": true,
  "description": "Nublue — aprenda matemática resolvendo quebra-cabeças numéricos.",
  "scripts": {
    "predev": "node infra/scripts/check-node.cjs",
    "dev": "npm run services:up && npm run services:wait && npm run migrations:up && next dev",
    "dev:seed": "node --env-file=.env.development infra/scripts/seed.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "vercel-build": "node infra/scripts/migrate.mjs up && node infra/scripts/seed.mjs && next build --webpack",
    "services:up": "docker compose -p nublue -f infra/compose.yaml up -d",
    "services:stop": "docker compose -p nublue -f infra/compose.yaml stop",
    "services:down": "docker compose -p nublue -f infra/compose.yaml down",
    "services:wait": "node --env-file=.env.development infra/scripts/wait-for-postgres.mjs",
    "migrations:create": "node-pg-migrate -m infra/migrations -j js create",
    "migrations:up": "node --env-file=.env.development infra/scripts/migrate.mjs up",
    "migrations:down": "node --env-file=.env.development infra/scripts/migrate.mjs down",
    "seed:production": "node infra/scripts/seed.mjs",
    "maintenance": "node infra/scripts/maintenance.mjs",
    "lint:check": "prettier --check .",
    "lint:fix": "prettier --write .",
    "pretest": "node infra/scripts/check-node.cjs",
    "test": "npm run services:up && npm run services:wait && npm run migrations:up && npm run dev:seed && jest --runInBand",
    "test:watch": "jest --watchAll --runInBand"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-dropdown-menu": "2.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.487.0",
    "motion": "12.23.24",
    "next": "^16.4.6",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "3.2.0",
    "tw-animate-css": "1.3.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5"
  },
  "engines": {
    "node": "24.x"
  }
}
