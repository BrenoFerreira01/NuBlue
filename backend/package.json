{
  "name": "nublue-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "seed": "node --env-file-if-exists=.env src/db/seed-course.js",
    "maintenance": "node --env-file-if-exists=.env src/db/maintenance-cli.js",
    "test": "node --test \"test/**/*.test.js\"",
    "validate:catalog": "node src/catalog/validate-cli.js"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.16"
  }
}
