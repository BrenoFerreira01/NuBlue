NODE_ENV=development
PORT=4000

# Origins allowed by CORS, comma-separated, without path.
# Production with GitHub Pages: FRONTEND_ORIGIN=https://brenoferreira01.github.io
FRONTEND_ORIGIN=http://localhost:5173

# Lax when frontend and API share a site (e.g. nublue.com.br + api.nublue.com.br).
# None when they are on different sites (GitHub Pages + API host); requires NODE_ENV=production.
COOKIE_SAME_SITE=Lax

# PlanetScale Postgres: app traffic through PgBouncer / transaction pooling (port 6432).
DATABASE_URL=postgres://USER:PASSWORD@HOST:6432/DATABASE?sslmode=require

# DDL and migration traffic through the direct connection (port 5432).
DATABASE_DIRECT_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# verify-full (default): TLS with certificate validation. disable: only for a local
# PostgreSQL without TLS (Docker, CI); refused when NODE_ENV=production.
# DATABASE_SSL=verify-full

# Connections per API instance (default 10). Keep instances x this below the pooler limit.
# DATABASE_POOL_MAX=10

# memory: one process (default outside production). postgres: shared by every instance
# through the rate_limit_buckets table (default in production).
# RATE_LIMIT_STORE=memory

# Reverse proxies in front of the API that append to X-Forwarded-For (most hosts: 1).
# 0 uses the socket address. Never set it higher than the real number of proxies.
# TRUST_PROXY_HOPS=0

# Public URL of the site, with base path: confirmation links point here (?verify=<token>).
# GitHub Pages: APP_URL=https://brenoferreira01.github.io/NuBlue/
APP_URL=http://localhost:5173/

# Resend (https://resend.com) sends the confirmation e-mails. Required in production.
# Without it (development, CI) the link is written to the API log instead.
# RESEND_API_KEY=re_...
# EMAIL_FROM=Nublue <nao-responda@your-verified-domain>
