# Cadastre estas variáveis no painel da Vercel (Settings → Environment Variables).
# Veja DEPLOY.md.

# Neon: conexão com pooler (app) e direta (migrações).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.sa-east-1.aws.neon.tech/DB?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.sa-east-1.aws.neon.tech/DB?sslmode=require

# Endereço público do site (links dos e-mails). Só em Production.
APP_URL=https://seu-dominio.com.br

# Resend via SMTP. Só em Production.
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=re_...
EMAIL_FROM=Nublue <nao-responda@seu-dominio.com.br>

# Protege /api/v1/cron/maintenance (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
CRON_SECRET=
